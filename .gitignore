# --- Xcode ---
# User-specific files (breakpoints, window positions, etc.)
xcuserdata/
DerivedData/
*.xcuserstate

# Build artifacts
build/
DerivedData/

# --- Swift Package Manager ---
# Ignore the build folder for dependencies
.build/
.swiftpm/

# --- macOS ---
# System files
.DS_Store
*.swp
*.lock

# --- Persistence (SwiftData/CoreData) ---
